            </column>
            <column caption='Attrition rate' datatype='real' name='[Calculation_1602718541937401857]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_1602718539258028032])/sum([Employee Count])' />
            </column>
